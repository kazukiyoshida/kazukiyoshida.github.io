---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Sidebar from "../components/Sidebar.tsx";
import MobileSidebar from "../components/MobileSidebar.tsx";

interface Props {
  title?: string;
  currentPath?: string;
}

const { title = "kazuki yoshida", currentPath = "/" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="kazuki yoshida - CrestAI 代表 / Software Engineer @Tokyo" />
    <title>{title}</title>
    <script is:inline define:vars={{ base }}>
      (function () {
        // Default to dark mode; only use light when explicitly chosen by the user
        var theme = localStorage.getItem("theme") === "light" ? "light" : "dark";
        document.documentElement.classList.toggle("dark", theme === "dark");
        // Preload sidebar background image for the active theme
        var img = theme === "dark"
          ? base + "/images/sidebar-bg.webp"
          : base + "/images/sidebar-bg-light-wo-clouds.webp";
        var link = document.createElement("link");
        link.rel = "preload";
        link.as = "image";
        link.href = img;
        document.head.appendChild(link);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script is:inline>
      // Fix: Astro View Transitions ignores popstate events where
      // history.state is null (i.e. the initial page load entry).
      // This breaks the browser's swipe-back gesture on mobile because
      // the URL updates but the DOM doesn't change.
      // Force a full page load in that case.
      window.addEventListener('popstate', function(ev) {
        if (ev.state === null) {
          location.reload();
        }
      });
    </script>
  </head>
  <body class="min-h-screen">
    <!-- Desktop Sidebar -->
    <!-- NOTE: transition:persist must only be set on the island, not on this wrapper.
         Nesting persisted elements makes WebKit (Safari) drop the inner island on navigation. -->
    <div class="hidden md:block">
      <Sidebar currentPath={currentPath} client:load transition:persist />
    </div>
    <!-- Mobile Header -->
    <MobileSidebar currentPath={currentPath} client:load transition:persist />
    <!-- Page Content -->
    <slot />
  </body>
</html>
